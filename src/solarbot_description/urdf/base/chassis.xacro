<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    chassis.xacro  —  base_footprint + base_link frame only.

    Track pods moved back to tracks.xacro (they are now real physics
    objects). Motor shaft visuals remain inline here since they are
    purely cosmetic with no physics role.
  -->

  <xacro:macro name="box_inertia" params="m lx ly lz">
    <inertia
      ixx="${m*(ly*ly + lz*lz)/12.0}" ixy="0" ixz="0"
      iyy="${m*(lx*lx + lz*lz)/12.0}" iyz="0"
      izz="${m*(lx*lx + ly*ly)/12.0}"/>
  </xacro:macro>

  <!-- base_footprint — ground-plane projection, used by Nav2 -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 ${base_z_above_ground}" rpy="0 0 0"/>
  </joint>

  <!-- base_link — rigid chassis body -->
  <link name="base_link">

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${chassis_mass}"/>
      <xacro:box_inertia
        m="${chassis_mass}"
        lx="${track_full_length}"
        ly="${motor_shaft_length}"
        lz="${track_pod_height}"/>
    </inertial>

    <!-- Central spine rail -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_rail_length} ${chassis_rail_width} ${chassis_rail_height}"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_rail_length} ${chassis_rail_width} ${chassis_rail_height}"/>
      </geometry>
    </collision>

    <!-- Front top plate -->
    <visual>
      <origin xyz="${plate_length} 0 ${plate_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${plate_length} ${plate_width} ${plate_thickness}"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="${plate_length} 0 ${plate_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${plate_length} ${plate_width} ${plate_thickness}"/>
      </geometry>
    </collision>

    <!-- Rear top plate -->
    <visual>
      <origin xyz="${-plate_length} 0 ${plate_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${plate_length} ${plate_width} ${plate_thickness}"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="${-plate_length} 0 ${plate_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${plate_length} ${plate_width} ${plate_thickness}"/>
      </geometry>
    </collision>

    <!-- Left side rail (visual only) -->
    <visual>
      <origin xyz="0 ${side_rail_y} ${side_rail_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${side_rail_length} ${side_rail_width} ${side_rail_height}"/>
      </geometry>
      <material name="silver"/>
    </visual>

    <!-- Right side rail (visual only) -->
    <visual>
      <origin xyz="0 ${-side_rail_y} ${side_rail_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${side_rail_length} ${side_rail_width} ${side_rail_height}"/>
      </geometry>
      <material name="silver"/>
    </visual>

    <!-- Front motor shaft (visual only) -->
    <visual>
      <origin xyz="${motor_front_x} 0 ${motor_z}" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="${motor_radius}" length="${motor_shaft_length}"/>
      </geometry>
      <material name="silver"/>
    </visual>

    <!-- Rear motor shaft (visual only) -->
    <visual>
      <origin xyz="${-motor_front_x} 0 ${motor_z}" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="${motor_radius}" length="${motor_shaft_length}"/>
      </geometry>
      <material name="silver"/>
    </visual>

  </link>

</robot>
