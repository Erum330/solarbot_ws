<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    chassis.xacro — Fully enclosed chassis body with side skirting and central camera shroud
  -->

  <xacro:macro name="box_inertia" params="m lx ly lz">
    <inertia
      ixx="${m*(ly*ly + lz*lz)/12.0}" ixy="0" ixz="0"
      iyy="${m*(lx*lx + lz*lz)/12.0}" iyz="0"
      izz="${m*(lx*lx + ly*ly)/12.0}"/>
  </xacro:macro>

  <!-- Skirt wheel-cutout macro: splits continuous skirt panel into 3 segments -->
  <xacro:property name="wheel_clearance" value="0.006"/>

  <xacro:macro name="skirt_side" params="y_pos">
    <!-- Front sliver -->
    <visual>
      <origin xyz="${(track_full_length/2 + track_front_x + wheel_radius + wheel_clearance)/2} ${y_pos} -0.010" rpy="0 0 0"/>
      <geometry>
        <box size="${track_full_length/2 - (track_front_x + wheel_radius + wheel_clearance)} 0.004 0.050"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="${(track_full_length/2 + track_front_x + wheel_radius + wheel_clearance)/2} ${y_pos} -0.010" rpy="0 0 0"/>
      <geometry>
        <box size="${track_full_length/2 - (track_front_x + wheel_radius + wheel_clearance)} 0.004 0.050"/>
      </geometry>
    </collision>

    <!-- Middle piece -->
    <visual>
      <origin xyz="0 ${y_pos} -0.010" rpy="0 0 0"/>
      <geometry>
        <box size="${2*(track_front_x - wheel_radius - wheel_clearance)} 0.004 0.050"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 ${y_pos} -0.010" rpy="0 0 0"/>
      <geometry>
        <box size="${2*(track_front_x - wheel_radius - wheel_clearance)} 0.004 0.050"/>
      </geometry>
    </collision>

    <!-- Rear sliver -->
    <visual>
      <origin xyz="${-(track_full_length/2 + track_front_x + wheel_radius + wheel_clearance)/2} ${y_pos} -0.010" rpy="0 0 0"/>
      <geometry>
        <box size="${track_full_length/2 - (track_front_x + wheel_radius + wheel_clearance)} 0.004 0.050"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="${-(track_full_length/2 + track_front_x + wheel_radius + wheel_clearance)/2} ${y_pos} -0.010" rpy="0 0 0"/>
      <geometry>
        <box size="${track_full_length/2 - (track_front_x + wheel_radius + wheel_clearance)} 0.004 0.050"/>
      </geometry>
    </collision>
  </xacro:macro>

  <!-- base_footprint — ground-plane projection, used by Nav2 -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 ${base_z_above_ground}" rpy="0 0 0"/>
  </joint>

  <!-- base_link — rigid chassis body -->
  <link name="base_link">

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${chassis_mass}"/>
      <xacro:box_inertia
        m="${chassis_mass}"
        lx="${track_full_length}"
        ly="0.180"
        lz="0.084"/>
    </inertial>

    <!-- 1. MAIN SOLID CHASSIS ENCLOSURE -->
    <visual>
      <origin xyz="0 0 0.010" rpy="0 0 0"/>
      <geometry>
        <box size="${track_full_length} 0.170 0.052"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.010" rpy="0 0 0"/>
      <geometry>
        <box size="${track_full_length} 0.170 0.052"/>
      </geometry>
    </collision>

    <!-- 2. FULL TOP LID DECK PLATE -->
    <visual>
      <origin xyz="0 0 0.037" rpy="0 0 0"/>
      <geometry>
        <box size="${track_full_length} 0.180 0.004"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.037" rpy="0 0 0"/>
      <geometry>
        <box size="${track_full_length} 0.180 0.004"/>
      </geometry>
    </collision>

    <!-- 3. SIDE SKIRTING -->
    <xacro:skirt_side y_pos="0.088"/>
    <xacro:skirt_side y_pos="-0.088"/>

    <!-- 4. CAMERA SHROUD (Rectangular hood around the downward camera) -->
    <xacro:property name="shroud_half_x" value="0.093"/>
    <xacro:property name="shroud_half_y" value="0.036"/>
    <xacro:property name="shroud_wall_t" value="0.003"/>
    <xacro:property name="shroud_top_z" value="-0.005"/>
    <xacro:property name="shroud_bottom_z" value="-0.038"/>
    <xacro:property name="shroud_height" value="${shroud_top_z - shroud_bottom_z}"/>
    <xacro:property name="shroud_center_z" value="${(shroud_top_z + shroud_bottom_z) / 2}"/>

    <!-- Front wall -->
    <visual>
      <origin xyz="${camera_x + shroud_half_x} ${camera_y} ${shroud_center_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${shroud_wall_t} ${shroud_half_y*2} ${shroud_height}"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <collision>
      <origin xyz="${camera_x + shroud_half_x} ${camera_y} ${shroud_center_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${shroud_wall_t} ${shroud_half_y*2} ${shroud_height}"/>
      </geometry>
    </collision>

    <!-- Rear wall -->
    <visual>
      <origin xyz="${camera_x - shroud_half_x} ${camera_y} ${shroud_center_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${shroud_wall_t} ${shroud_half_y*2} ${shroud_height}"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <collision>
      <origin xyz="${camera_x - shroud_half_x} ${camera_y} ${shroud_center_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${shroud_wall_t} ${shroud_half_y*2} ${shroud_height}"/>
      </geometry>
    </collision>

    <!-- Left wall -->
    <visual>
      <origin xyz="${camera_x} ${camera_y + shroud_half_y} ${shroud_center_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${shroud_half_x*2} ${shroud_wall_t} ${shroud_height}"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <collision>
      <origin xyz="${camera_x} ${camera_y + shroud_half_y} ${shroud_center_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${shroud_half_x*2} ${shroud_wall_t} ${shroud_height}"/>
      </geometry>
    </collision>

    <!-- Right wall -->
    <visual>
      <origin xyz="${camera_x} ${camera_y - shroud_half_y} ${shroud_center_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${shroud_half_x*2} ${shroud_wall_t} ${shroud_height}"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <collision>
      <origin xyz="${camera_x} ${camera_y - shroud_half_y} ${shroud_center_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${shroud_half_x*2} ${shroud_wall_t} ${shroud_height}"/>
      </geometry>
    </collision>

    <!-- Front motor shaft (visual only) -->
    <visual>
      <origin xyz="${motor_front_x} 0 ${motor_z}" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="${motor_radius}" length="${motor_shaft_length}"/>
      </geometry>
      <material name="silver"/>
    </visual>

    <!-- Rear motor shaft (visual only) -->
    <visual>
      <origin xyz="${-motor_front_x} 0 ${motor_z}" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="${motor_radius}" length="${motor_shaft_length}"/>
      </geometry>
      <material name="silver"/>
    </visual>

  </link>

</robot>