<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    chassis.xacro — Fully enclosed, light-tight chassis body with original silver material
  -->

  <xacro:macro name="box_inertia" params="m lx ly lz">
    <inertia
      ixx="${m*(ly*ly + lz*lz)/12.0}" ixy="0" ixz="0"
      iyy="${m*(lx*lx + lz*lz)/12.0}" iyz="0"
      izz="${m*(lx*lx + ly*ly)/12.0}"/>
  </xacro:macro>

  <!-- Skirt wheel-cutout macro: splits what was a single continuous
       skirt panel into 3 segments (front sliver / large middle piece /
       rear sliver), leaving a gap at each wheel's X-position instead of
       moving the skirt's Y-position outward. wheel_clearance gives a
       small safety margin beyond the wheel's physical radius. -->
  <xacro:property name="wheel_clearance" value="0.006"/>

  <xacro:macro name="skirt_side" params="y_pos">
    <!-- Front sliver: between front wheel's cutout and the chassis front edge -->
    <visual>
      <origin xyz="${(track_full_length/2 + track_front_x + wheel_radius + wheel_clearance)/2} ${y_pos} -0.010" rpy="0 0 0"/>
      <geometry>
        <box size="${track_full_length/2 - (track_front_x + wheel_radius + wheel_clearance)} 0.004 0.050"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="${(track_full_length/2 + track_front_x + wheel_radius + wheel_clearance)/2} ${y_pos} -0.010" rpy="0 0 0"/>
      <geometry>
        <box size="${track_full_length/2 - (track_front_x + wheel_radius + wheel_clearance)} 0.004 0.050"/>
      </geometry>
    </collision>

    <!-- Middle: between the front and rear wheel cutouts -->
    <visual>
      <origin xyz="0 ${y_pos} -0.010" rpy="0 0 0"/>
      <geometry>
        <box size="${2*(track_front_x - wheel_radius - wheel_clearance)} 0.004 0.050"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 ${y_pos} -0.010" rpy="0 0 0"/>
      <geometry>
        <box size="${2*(track_front_x - wheel_radius - wheel_clearance)} 0.004 0.050"/>
      </geometry>
    </collision>

    <!-- Rear sliver: mirror of the front sliver -->
    <visual>
      <origin xyz="${-(track_full_length/2 + track_front_x + wheel_radius + wheel_clearance)/2} ${y_pos} -0.010" rpy="0 0 0"/>
      <geometry>
        <box size="${track_full_length/2 - (track_front_x + wheel_radius + wheel_clearance)} 0.004 0.050"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="${-(track_full_length/2 + track_front_x + wheel_radius + wheel_clearance)/2} ${y_pos} -0.010" rpy="0 0 0"/>
      <geometry>
        <box size="${track_full_length/2 - (track_front_x + wheel_radius + wheel_clearance)} 0.004 0.050"/>
      </geometry>
    </collision>
  </xacro:macro>

  <!-- base_footprint — ground-plane projection, used by Nav2 -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 ${base_z_above_ground}" rpy="0 0 0"/>
  </joint>

  <!-- base_link — rigid chassis body -->
  <link name="base_link">

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${chassis_mass}"/>
      <xacro:box_inertia
        m="${chassis_mass}"
        lx="${track_full_length}"
        ly="0.180"
        lz="0.084"/>
    </inertial>

    <!-- 1. MAIN SOLID CHASSIS ENCLOSURE (Fills space from bottom to top deck plate, 0 gaps) -->
    <visual>
      <origin xyz="0 0 0.010" rpy="0 0 0"/>
      <geometry>
        <box size="${track_full_length} 0.170 0.052"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.010" rpy="0 0 0"/>
      <geometry>
        <box size="${track_full_length} 0.170 0.052"/>
      </geometry>
    </collision>

    <!-- 2. FULL TOP LID DECK PLATE (Seals the top surface under electronics) -->
    <visual>
      <origin xyz="0 0 0.037" rpy="0 0 0"/>
      <geometry>
        <box size="${track_full_length} 0.180 0.004"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.037" rpy="0 0 0"/>
      <geometry>
        <box size="${track_full_length} 0.180 0.004"/>
      </geometry>
    </collision>

    <!-- 3. SIDE SKIRTING (Extends down along wheels to block side glare
         into bottom camera) - Y position kept at 0.088 as originally
         specified. Wheel interference resolved via cutouts (3 segments
         per side, see skirt_side macro above) rather than moving the
         skirt outward. -->
    <xacro:skirt_side y_pos="0.088"/>
    <xacro:skirt_side y_pos="-0.088"/>

    <!-- Front motor shaft (visual only) -->
    <visual>
      <origin xyz="${motor_front_x} 0 ${motor_z}" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="${motor_radius}" length="${motor_shaft_length}"/>
      </geometry>
      <material name="silver"/>
    </visual>

    <!-- Rear motor shaft (visual only) -->
    <visual>
      <origin xyz="${-motor_front_x} 0 ${motor_z}" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="${motor_radius}" length="${motor_shaft_length}"/>
      </geometry>
      <material name="silver"/>
    </visual>

  </link>

</robot>