<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    tracks.xacro
    ─────────────────────────────────────────────────────────────────
    Four track pod links — each is a real physics object.

    No virtual wheel links. Each track pod IS the wheel:

        ┌──────────────────┐   ← box VISUAL  (track appearance)
        │                  │
        │      ╔════╗      │   ← cylinder COLLISION  (rolls on ground)
        │      ║ O  ║      │     radius = wheel_radius = 0.026 m
        │      ╚════╝      │     length = track_pod_width  = 0.050 m
        │                  │
        └──────────────────┘

    Why cylinder collision, box visual?
      • The cylinder is what Gazebo's ODE solver rolls on the ground —
        it produces a clean, stable single contact line per pod.
      • The box visual is the appearance of the rubber track.
      • A box collision would have 4 contact points that fight each
        other and make the robot jitter.

    DiffDrive drives all 4 joints as two pairs:
      LEFT  pair: front_left_wheel_joint + rear_left_wheel_joint
      RIGHT pair: front_right_wheel_joint + rear_right_wheel_joint

    Joint naming convention: ${name}_wheel_joint
      This is what gazebo.xacro DiffDrive plugin and
      ros2_control.xacro both reference.

    Depends on: common/properties.xacro, common/materials.xacro
  ─────────────────────────────────────────────────────────────────
  -->

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertia
      ixx="${m*(3.0*r*r + h*h)/12.0}" ixy="0" ixz="0"
      iyy="${m*(3.0*r*r + h*h)/12.0}" iyz="0"
      izz="${m*r*r/2.0}"/>
  </xacro:macro>

  <!-- ══════════════════════════════════════════════════════════ -->
  <!-- track_pod macro                                           -->
  <!-- ══════════════════════════════════════════════════════════ -->
  <xacro:macro name="track_pod" params="name x y">

    <link name="${name}_track_link">

      <!--
        Inertia: modelled as a solid cylinder (not box) to match the
        cylinder collision shape. mass = 0.45 kg per pod.
      -->
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${track_pod_mass}"/>
        <xacro:cylinder_inertia
          m="${track_pod_mass}"
          r="${wheel_radius}"
          h="${track_pod_width}"/>
      </inertial>

      <!-- VISUAL: box → the rubber track appearance -->
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${track_pod_length} ${track_pod_width} ${track_pod_height}"/>
        </geometry>
        <material name="black"/>
      </visual>

      <!--
        COLLISION: cylinder → the rolling contact surface.

        rpy="1.5708 0 0" rotates the cylinder from its default
        z-axis orientation to the y-axis so it rolls when the
        joint spins around y (axis xyz="0 1 0" in the joint below).

        Radius = wheel_radius = 0.026 m.
        The joint origin places the cylinder centre exactly at
        ground contact height.
      -->
      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${track_pod_width}"/>
        </geometry>
      </collision>

    </link>

    <!--
      Continuous joint — DiffDrive can command velocity on this.

      Joint origin z = -wheel_radius from base_link.
      base_link is at z = wheel_radius above ground (base_z_above_ground).
      Therefore wheel centre in world frame = wheel_radius - wheel_radius = 0,
      i.e. at ground level. Gazebo contact dynamics with minDepth handle
      the small cylinder–ground overlap.
    -->
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child  link="${name}_track_link"/>
      <origin xyz="${x} ${y} ${-wheel_radius}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.05" friction="0.1"/>
    </joint>

  </xacro:macro>

  <!-- ══════════════════════════════════════════════════════════ -->
  <!-- Instantiate all four track pods                          -->
  <!-- ══════════════════════════════════════════════════════════ -->

  <xacro:track_pod name="front_left"  x="${track_front_x}" y="${track_y_offset}"/>
  <xacro:track_pod name="rear_left"   x="${track_rear_x}"  y="${track_y_offset}"/>
  <xacro:track_pod name="front_right" x="${track_front_x}" y="${-track_y_offset}"/>
  <xacro:track_pod name="rear_right"  x="${track_rear_x}"  y="${-track_y_offset}"/>

</robot>
