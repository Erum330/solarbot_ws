<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    ros2_control.xacro
    Updated to reference all 4 track wheel joints (front + rear per side).
    On real hardware these are electrically paired (L+L, R+R) so commanding
    both joints on each side with the same value is physically correct.
  -->
<!-- 
  <xacro:arg name="use_real_hardware" default="false"/>
  <xacro:arg name="serial_port"       default="/dev/ttyACM0"/> -->

  <!-- <ros2_control name="SolarbotHardware" type="system">
    <hardware>
      <xacro:if value="$(arg use_real_hardware)">
        <plugin>diffdrive_arduino/DiffDriveArduinoHardware</plugin>
        <param name="serial_port">$(arg serial_port)</param>
        <param name="baud_rate">115200</param>
        <param name="wheel_radius">${wheel_radius}</param>
        <param name="max_wheel_rad_s">6.0</param>
      </xacro:if>
      <xacro:unless value="$(arg use_real_hardware)">
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        <param name="calculate_dynamics">true</param>
      </xacro:unless>
    </hardware> -->

  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>


    <joint name="front_left_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface   name="velocity"/>
      <state_interface   name="position"/>
    </joint>
    <joint name="rear_left_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface   name="velocity"/>
      <state_interface   name="position"/>
    </joint>
    <joint name="front_right_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface   name="velocity"/>
      <state_interface   name="position"/>
    </joint>
    <joint name="rear_right_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface   name="velocity"/>
      <state_interface   name="position"/>
    </joint>

  </ros2_control>

  <!-- ================================================= -->
  <!-- Gazebo ROS2 Control Plugin                       -->
  <!-- ================================================= -->
  <gazebo>
    <plugin filename="libgz_ros2_control-system.so"
        name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(find solarbot_gazebo)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>