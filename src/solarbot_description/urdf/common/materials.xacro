<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================= -->
  <!-- Materials                     -->
  <!-- ============================= -->

  <material name="black">
    <color rgba="0.10 0.10 0.10 1.0"/>
  </material>

  <material name="dark_gray">
    <color rgba="0.25 0.25 0.25 1.0"/>
  </material>

  <material name="light_gray">
    <color rgba="0.75 0.75 0.75 1.0"/>
  </material>

  <material name="silver">
    <color rgba="0.82 0.82 0.82 1.0"/>
  </material>

  <material name="blue">
    <color rgba="0.10 0.30 0.90 1.0"/>
  </material>

  <material name="green">
    <color rgba="0.10 0.80 0.20 1.0"/>
  </material>

  <material name="red">
    <color rgba="0.90 0.10 0.10 1.0"/>
  </material>

  <material name="yellow">
    <color rgba="1.00 0.90 0.10 1.0"/>
  </material>

</robot>