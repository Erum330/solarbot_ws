<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    materials.xacro
    All colour definitions. Reference by name everywhere else.
  -->

  <material name="silver">
    <color rgba="0.75 0.75 0.72 1.0"/>
  </material>

  <material name="black">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>

  <material name="dark_gray">
    <color rgba="0.15 0.15 0.15 1.0"/>
  </material>

  <!-- Sensor boards (IMU, ToF) -->
  <material name="blue">
    <color rgba="0.0 0.25 0.8 1.0"/>
  </material>

  <!-- Camera module -->
  <material name="camera_gray">
    <color rgba="0.20 0.20 0.20 1.0"/>
  </material>

  <!-- Raspberry Pi board -->
  <material name="green">
    <color rgba="0.05 0.45 0.10 1.0"/>
  </material>

  <!-- STM32 safety controller -->
  <material name="red">
    <color rgba="0.80 0.05 0.05 1.0"/>
  </material>

</robot>
