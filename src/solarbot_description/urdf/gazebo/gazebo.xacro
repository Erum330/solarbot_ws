<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    gazebo.xacro — Gazebo Harmonic plugin and sensor definitions.
    Updated: High-fidelity sensor configurations and skid-steer friction values.
  -->

  <!-- ══ 1. Joint State Publisher ═════════════════════════════ -->
  <!-- Publishes inside the Gazebo environment for core simulation mechanics -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <joint_name>front_left_wheel_joint</joint_name>
      <joint_name>rear_left_wheel_joint</joint_name>
      <joint_name>front_right_wheel_joint</joint_name>
      <joint_name>rear_right_wheel_joint</joint_name>
      <topic>joint_states</topic>
    </plugin>
  </gazebo>

  <!-- ══ 1b. Ground-truth odometry (SIM ONLY, for validation) ═══ -->
  <!-- Publishes the model's actual world pose, unaffected by wheel
       slip — this is the ground truth /odom_cam should be compared
       against, matching the paper's evaluation method. Do NOT feed
       this into any controller or EKF; it does not exist on real
       hardware. -->
  <gazebo>
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_frame>ground_truth_odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <dimensions>3</dimensions>
      <odom_publish_frequency>30</odom_publish_frequency>
      <odom_topic>/ground_truth/odom</odom_topic>
    </plugin>
  </gazebo>
  

  <!-- ══ 2. IMU sensor ════════════════════════════════════════ -->
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <topic>/imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.009</stddev><bias_mean>0.0</bias_mean><bias_stddev>0.001</bias_stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.009</stddev><bias_mean>0.0</bias_mean><bias_stddev>0.001</bias_stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.009</stddev><bias_mean>0.0</bias_mean><bias_stddev>0.001</bias_stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.021</stddev><bias_mean>0.1</bias_mean><bias_stddev>0.001</bias_stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.021</stddev><bias_mean>0.1</bias_mean><bias_stddev>0.001</bias_stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.021</stddev><bias_mean>0.1</bias_mean><bias_stddev>0.001</bias_stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

<!-- ══ GPS (NavSat) sensor ══════════════════════════════════ -->
  <gazebo reference="gps_link">
    <sensor name="gps_sensor" type="navsat">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <topic>/gps/fix</topic>
      <gz_frame_id>gps_link</gz_frame_id>
      <navsat>
        <position_sensing>
          <horizontal>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.00001</stddev>  <!-- ~1.1 meter realistic GNSS noise -->
            </noise>
          </horizontal>
          <vertical>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.00002</stddev>  <!-- ~2.2 meter altitude noise -->
            </noise>
          </vertical>
        </position_sensing>
      </navsat>
    </sensor>
  </gazebo>

  <!-- ══ 3. Downward camera ═══════════════════════════════════ -->
  <gazebo reference="downward_camera_link">
    <sensor name="downward_camera" type="camera">
      <always_on>true</always_on>
      <update_rate>40</update_rate>
      <visualize>false</visualize>
      <topic>/camera/image_raw</topic>
      <camera>
        <!-- OV9732 datasheet: 100 deg horizontal FOV = 1.74533 rad -->
        <horizontal_fov>2.20</horizontal_fov>
        <image>
           <!-- Native OV9732 resolution/aspect (16:9), matches USB listing -->
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>5.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <!-- ══ 4. Cliff ToF macro (single-beam lidar) ══════════════ -->
  <xacro:macro name="cliff_tof_gazebo" params="link_name topic">
    <gazebo reference="${link_name}">
      <sensor name="${link_name}_sensor" type="gpu_lidar">
        <always_on>true</always_on>
        <update_rate>50</update_rate>
        <topic>${topic}</topic>
        <gz_frame_id>${link_name}</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>1</samples><resolution>1</resolution>
              <min_angle>0</min_angle><max_angle>0</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples><resolution>1</resolution>
              <min_angle>0</min_angle><max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.010</min><max>1.200</max><resolution>0.001</resolution>
          </range>
          <noise>
            <type>gaussian</type><mean>0.0</mean><stddev>0.002</stddev>
          </noise>
        </lidar>
      </sensor>
    </gazebo>
  </xacro:macro>

  <xacro:cliff_tof_gazebo link_name="front_mid_tof_link" topic="/front_mid_tof"/>
  <xacro:cliff_tof_gazebo link_name="rear_mid_tof_link"  topic="/rear_mid_tof"/>
  <xacro:cliff_tof_gazebo link_name="left_mid_tof_link"  topic="/left_mid_tof"/>

  <!-- ══ 5. Right side grid ToF (VL53L5CX-class, simulated approximation) ═ -->
  <!-- Real sensor: genuine 8x8=64-ray grid. This block now matches that
       directly - 8 horizontal x 8 vertical samples, both spanning
       +/-22.98deg (per-axis FOV derived from the confirmed real 65deg
       diagonal FOV, same method the VL53L5CX-BNO08X-viewer firmware's
       own config.py uses). This gives Gazebo's own ray visualization
       and physics a true square-spreading fan, matching the real
       sensor's reference visualization - NOT the earlier 64x1
       flattened-single-row approximation, which looked like a flat
       line/wedge instead of a square.

       STILL UNVERIFIED: whether ros_gz_bridge's LaserScan converter
       correctly carries through BOTH dimensions to ROS's
       sensor_msgs/LaserScan, which has no vertical field at all. Gazebo's
       own internal gz.msgs.LaserScan CAN represent 2D scan data, but the
       ROS-side message fundamentally cannot - the bridge's actual
       behavior with a genuinely 2D input (rather than 1D) needs
       confirming empirically once this is running, not assumed.
       CHECK THIS FIRST once built: run "ros2 topic echo /right_mid_tof
       once" (single dash flag, not shown literally here since XML
       comments can't contain double-dash sequences)
       - does `ranges` contain all 64 values, or does something look
       wrong/truncated/only-one-row? If the bridge mishandles the 2D
       input, the fallback is switching this sensor to publish
       PointCloud2 instead (which natively supports 2D structure) and
       updating solarbot_perimeter_node.py's parsing to match - a real
       scope increase, not attempted here, but the correct fix if the
       LaserScan bridge turns out not to work cleanly.

       Range 0.020-4.000m matches config.py's real MIN_RANGE_MM/
       MAX_RANGE_MM exactly. Orientation (down + outward tilt) is
       inherited automatically from right_mid_tof_link's joint in
       sensors.xacro - not configured here.

       NOTE: the 4m max range above is a sensor ceiling, not a
       guarantee of reach - actual horizontal reach into the panel
       gaps is set by mount height + tilt angle (see the reach-vs-tilt
       derivation on the right_mid_tof instantiation in sensors.xacro).
       With the current 30.6deg-below-horizontal boresight and 5cm
       mount height, the grid's rows reach roughly 3.8-35cm depending
       on row, nowhere near 4m - that's expected and correct for
       resolving a 0.3-0.5m gap up close, not a sign of something
       wrong with the range config here. -->
  <gazebo reference="right_mid_tof_link">
    <sensor name="right_mid_tof_sensor" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>50</update_rate>
      <topic>/right_mid_tof</topic>
      <gz_frame_id>right_mid_tof_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>8</samples><resolution>1</resolution>
            <min_angle>-0.4011</min_angle><max_angle>0.4011</max_angle>
          </horizontal>
          <vertical>
            <samples>8</samples><resolution>1</resolution>
            <min_angle>-0.4011</min_angle><max_angle>0.4011</max_angle>
          </vertical>
        </scan>
        <range>
          <!-- Confirmed real datasheet values (VL53L5CX-BNO08X-viewer
               firmware's config.py: MIN_RANGE_MM=20, MAX_RANGE_MM=4000),
               not estimates. -->
          <min>0.020</min><max>4.000</max><resolution>0.001</resolution>
        </range>
        <noise>
          <type>gaussian</type><mean>0.0</mean><stddev>0.002</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- ══ 6. Wheel friction ════════════════════════════════════ -->
  <xacro:macro name="wheel_friction" params="link_name">
    <gazebo reference="${link_name}">
      <mu1>0.9</mu1><!-- longitudinal: grip for forward/back -->
      <mu2>0.2</mu2>
      <fdir1>1 0 0 </fdir1>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <minDepth>0.001</minDepth>
      <maxContacts>4</maxContacts>
    </gazebo>
  </xacro:macro>

  <xacro:wheel_friction link_name="front_left_wheel_link"/>
  <xacro:wheel_friction link_name="rear_left_wheel_link"/>
  <xacro:wheel_friction link_name="front_right_wheel_link"/>
  <xacro:wheel_friction link_name="rear_right_wheel_link"/>

  <!-- ══ 7. Gazebo material colours ═══════════════════════════ -->
  <gazebo reference="base_link">        <material>Gazebo/Silver</material>    </gazebo>
  <gazebo reference="front_left_wheel_link">  <material>Gazebo/DarkGrey</material> </gazebo>
  <gazebo reference="rear_left_wheel_link">   <material>Gazebo/DarkGrey</material> </gazebo>
  <gazebo reference="front_right_wheel_link"> <material>Gazebo/DarkGrey</material> </gazebo>
  <gazebo reference="rear_right_wheel_link">  <material>Gazebo/DarkGrey</material> </gazebo>
  <gazebo reference="raspberry_pi_link"> <material>Gazebo/Green</material>    </gazebo>
  <gazebo reference="arduino_link">      <material>Gazebo/Blue</material>     </gazebo>
  <gazebo reference="battery_link">      <material>Gazebo/Black</material>    </gazebo>
  <gazebo reference="esp32_link">        <material>Gazebo/Blue</material>     </gazebo>
  <gazebo reference="stm32_link">        <material>Gazebo/Red</material>      </gazebo>
  <gazebo reference="imu_link">          <material>Gazebo/Blue</material>     </gazebo>
  <gazebo reference="downward_camera_link"> <material>Gazebo/DarkGrey</material> </gazebo>
  <gazebo reference="front_mid_tof_link">   <material>Gazebo/Blue</material>  </gazebo>
  <gazebo reference="rear_mid_tof_link">    <material>Gazebo/Blue</material>  </gazebo>
  <gazebo reference="left_mid_tof_link">    <material>Gazebo/Blue</material>  </gazebo>
  <gazebo reference="right_mid_tof_link">   <material>Gazebo/DarkGrey</material>  </gazebo>

</robot>