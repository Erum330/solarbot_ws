<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    gazebo.xacro — Gazebo Harmonic plugin and sensor definitions.
    Updated: High-fidelity sensor configurations and skid-steer friction values.
  -->

  <!-- ══ 1. Joint State Publisher ═════════════════════════════ -->
  <!-- Publishes inside the Gazebo environment for core simulation mechanics -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <joint_name>front_left_wheel_joint</joint_name>
      <joint_name>rear_left_wheel_joint</joint_name>
      <joint_name>front_right_wheel_joint</joint_name>
      <joint_name>rear_right_wheel_joint</joint_name>
      <topic>joint_states</topic>
    </plugin>
  </gazebo>

  <!-- ══ 1b. Ground-truth odometry (SIM ONLY, for validation) ═══ -->
  <!-- Publishes the model's actual world pose, unaffected by wheel
       slip — this is the ground truth /odom_cam should be compared
       against, matching the paper's evaluation method. Do NOT feed
       this into any controller or EKF; it does not exist on real
       hardware. -->
  <gazebo>
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_frame>ground_truth_odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <dimensions>3</dimensions>
      <odom_publish_frequency>30</odom_publish_frequency>
      <odom_topic>/ground_truth/odom</odom_topic>
    </plugin>
  </gazebo>

  <!-- ══ 2. IMU sensor ════════════════════════════════════════ -->
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <topic>/imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.009</stddev><bias_mean>0.0</bias_mean><bias_stddev>0.001</bias_stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.009</stddev><bias_mean>0.0</bias_mean><bias_stddev>0.001</bias_stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.009</stddev><bias_mean>0.0</bias_mean><bias_stddev>0.001</bias_stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.021</stddev><bias_mean>0.1</bias_mean><bias_stddev>0.001</bias_stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.021</stddev><bias_mean>0.1</bias_mean><bias_stddev>0.001</bias_stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.021</stddev><bias_mean>0.1</bias_mean><bias_stddev>0.001</bias_stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

<!-- ══ GPS (NavSat) sensor ══════════════════════════════════ -->
  <gazebo reference="gps_link">
    <sensor name="gps_sensor" type="navsat">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <topic>/gps/fix</topic>
      <gz_frame_id>gps_link</gz_frame_id>
      <navsat>
        <position_sensing>
          <horizontal>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.00001</stddev>  <!-- ~1.1 meter realistic GNSS noise -->
            </noise>
          </horizontal>
          <vertical>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.00002</stddev>  <!-- ~2.2 meter altitude noise -->
            </noise>
          </vertical>
        </position_sensing>
      </navsat>
    </sensor>
  </gazebo>

  <!-- ══ 3. Downward camera ═══════════════════════════════════ -->
  <gazebo reference="downward_camera_link">
    <sensor name="downward_camera" type="camera">
      <always_on>true</always_on>
      <update_rate>40</update_rate>
      <visualize>false</visualize>
      <topic>/camera/image_raw</topic>
      <camera>
        <!-- OV9732 datasheet: 100 deg horizontal FOV = 1.74533 rad -->
        <horizontal_fov>2.20</horizontal_fov>
        <image>
           <!-- Native OV9732 resolution/aspect (16:9), matches USB listing -->
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>5.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <!-- ══ 4. Cliff ToF macro (single-beam lidar) ══════════════ -->
  <xacro:macro name="cliff_tof_gazebo" params="link_name topic">
    <gazebo reference="${link_name}">
      <sensor name="${link_name}_sensor" type="gpu_lidar">
        <always_on>true</always_on>
        <update_rate>50</update_rate>
        <topic>${topic}</topic>
        <gz_frame_id>${link_name}</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>1</samples><resolution>1</resolution>
              <min_angle>0</min_angle><max_angle>0</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples><resolution>1</resolution>
              <min_angle>0</min_angle><max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.010</min><max>1.200</max><resolution>0.001</resolution>
          </range>
          <noise>
            <type>gaussian</type><mean>0.0</mean><stddev>0.002</stddev>
          </noise>
        </lidar>
      </sensor>
    </gazebo>
  </xacro:macro>

  <xacro:cliff_tof_gazebo link_name="front_left_tof_link"   topic="/front_left_tof"/>
  <xacro:cliff_tof_gazebo link_name="front_right_tof_link" topic="/front_right_tof"/>
  <xacro:cliff_tof_gazebo link_name="rear_left_tof_link"    topic="/rear_left_tof"/>
  <xacro:cliff_tof_gazebo link_name="rear_right_tof_link"   topic="/rear_right_tof"/>

  <!-- ══ 5. Front obstacle ToF ════════════════════════════════ -->
  <gazebo reference="front_tof_link">
    <sensor name="front_tof_sensor" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>50</update_rate>
      <topic>/front_tof</topic>
      <gz_frame_id>front_tof_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>1</samples><resolution>1</resolution>
            <min_angle>0</min_angle><max_angle>0</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples><resolution>1</resolution>
            <min_angle>0</min_angle><max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.010</min><max>2.000</max><resolution>0.001</resolution>
        </range>
        <noise>
          <type>gaussian</type><mean>0.0</mean><stddev>0.003</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- ══ 6. Wheel friction ════════════════════════════════════ -->
  <xacro:macro name="wheel_friction" params="link_name">
    <gazebo reference="${link_name}">
      <mu1>0.9</mu1><!-- longitudinal: grip for forward/back -->
      <mu2>0.2</mu2>
      <fdir1>1 0 0 </fdir1>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <minDepth>0.001</minDepth>
      <maxContacts>4</maxContacts>
    </gazebo>
  </xacro:macro>

  <xacro:wheel_friction link_name="front_left_wheel_link"/>
  <xacro:wheel_friction link_name="rear_left_wheel_link"/>
  <xacro:wheel_friction link_name="front_right_wheel_link"/>
  <xacro:wheel_friction link_name="rear_right_wheel_link"/>

  <!-- ══ 7. Gazebo material colours ═══════════════════════════ -->
  <gazebo reference="base_link">        <material>Gazebo/Silver</material>    </gazebo>
  <gazebo reference="front_left_wheel_link">  <material>Gazebo/DarkGrey</material> </gazebo>
  <gazebo reference="rear_left_wheel_link">   <material>Gazebo/DarkGrey</material> </gazebo>
  <gazebo reference="front_right_wheel_link"> <material>Gazebo/DarkGrey</material> </gazebo>
  <gazebo reference="rear_right_wheel_link">  <material>Gazebo/DarkGrey</material> </gazebo>
  <gazebo reference="raspberry_pi_link"> <material>Gazebo/Green</material>    </gazebo>
  <gazebo reference="arduino_link">      <material>Gazebo/Blue</material>     </gazebo>
  <gazebo reference="battery_link">      <material>Gazebo/Black</material>    </gazebo>
  <gazebo reference="esp32_link">        <material>Gazebo/Blue</material>     </gazebo>
  <gazebo reference="stm32_link">        <material>Gazebo/Red</material>      </gazebo>
  <gazebo reference="imu_link">          <material>Gazebo/Blue</material>     </gazebo>
  <gazebo reference="downward_camera_link"> <material>Gazebo/DarkGrey</material> </gazebo>
  <gazebo reference="front_tof_link">       <material>Gazebo/Blue</material>  </gazebo>
  <gazebo reference="front_left_tof_link">  <material>Gazebo/Blue</material>  </gazebo>
  <gazebo reference="front_right_tof_link"> <material>Gazebo/Blue</material>  </gazebo>
  <gazebo reference="rear_left_tof_link">   <material>Gazebo/Blue</material>  </gazebo>
  <gazebo reference="rear_right_tof_link">  <material>Gazebo/Blue</material>  </gazebo>

</robot>