<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    gazebo.xacro — Gazebo Harmonic plugin and sensor definitions.
    Updated: DiffDrive drives all 4 track joints, friction on all 4 pods.
  -->

  <!-- ══ 1. DiffDrive plugin (replaces gz_ros2_control) ══════ -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
      <!-- LEFT pair -->
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <!-- RIGHT pair -->
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>

      <wheel_separation>0.156</wheel_separation>
      <wheel_radius>0.026</wheel_radius>

      <odom_publish_frequency>30</odom_publish_frequency>
      <topic>cmd_vel</topic>
      <odom_topic>odometry</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>

      <max_linear_acceleration>0.5</max_linear_acceleration>
      <max_angular_acceleration>1.0</max_angular_acceleration>
      <min_velocity>-0.15</min_velocity>
      <max_velocity>0.15</max_velocity>
    </plugin>
  </gazebo>

  <!-- Joint state publisher — publishes all 4 wheel joint states -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <joint_name>front_left_wheel_joint</joint_name>
      <joint_name>rear_left_wheel_joint</joint_name>
      <joint_name>front_right_wheel_joint</joint_name>
      <joint_name>rear_right_wheel_joint</joint_name>
      <topic>joint_states</topic>
    </plugin>
  </gazebo>

  <!-- ══ 2. IMU sensor ════════════════════════════════════════ -->
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <topic>/imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.009</stddev><bias_mean>0.0</bias_mean><bias_stddev>0.001</bias_stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.009</stddev><bias_mean>0.0</bias_mean><bias_stddev>0.001</bias_stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.009</stddev><bias_mean>0.0</bias_mean><bias_stddev>0.001</bias_stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.021</stddev><bias_mean>0.1</bias_mean><bias_stddev>0.001</bias_stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.021</stddev><bias_mean>0.1</bias_mean><bias_stddev>0.001</bias_stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.021</stddev><bias_mean>0.1</bias_mean><bias_stddev>0.001</bias_stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!-- ══ 3. Downward camera ═══════════════════════════════════ -->
  <gazebo reference="downward_camera_link">
    <sensor name="downward_camera" type="camera">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <topic>/camera/image_raw</topic>
      <gz_frame_id>downward_camera_optical_frame</gz_frame_id>
      <camera name="downward_camera">
        <horizontal_fov>1.3614</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.005</near>
          <far>0.50</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.005</stddev>
        </noise>
      </camera>
    </sensor>
  </gazebo>

  <!-- ══ 4. Cliff ToF macro (single-beam lidar) ══════════════ -->
  <xacro:macro name="cliff_tof_gazebo" params="link_name topic">
    <gazebo reference="${link_name}">
      <sensor name="${link_name}_sensor" type="gpu_lidar">
        <always_on>true</always_on>
        <update_rate>50</update_rate>
        <topic>${topic}</topic>
        <gz_frame_id>${link_name}</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>1</samples><resolution>1</resolution>
              <min_angle>0</min_angle><max_angle>0</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples><resolution>1</resolution>
              <min_angle>0</min_angle><max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.010</min><max>1.200</max><resolution>0.001</resolution>
          </range>
          <noise>
            <type>gaussian</type><mean>0.0</mean><stddev>0.002</stddev>
          </noise>
        </lidar>
      </sensor>
    </gazebo>
  </xacro:macro>

  <xacro:cliff_tof_gazebo link_name="front_left_tof_link"  topic="/front_left_tof"/>
  <xacro:cliff_tof_gazebo link_name="front_right_tof_link" topic="/front_right_tof"/>
  <xacro:cliff_tof_gazebo link_name="rear_left_tof_link"   topic="/rear_left_tof"/>
  <xacro:cliff_tof_gazebo link_name="rear_right_tof_link"  topic="/rear_right_tof"/>

  <!-- ══ 5. Front obstacle ToF ════════════════════════════════ -->
  <gazebo reference="front_tof_link">
    <sensor name="front_tof_sensor" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>50</update_rate>
      <topic>/front_tof</topic>
      <gz_frame_id>front_tof_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>1</samples><resolution>1</resolution>
            <min_angle>0</min_angle><max_angle>0</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples><resolution>1</resolution>
            <min_angle>0</min_angle><max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.010</min><max>2.000</max><resolution>0.001</resolution>
        </range>
        <noise>
          <type>gaussian</type><mean>0.0</mean><stddev>0.003</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- ══ 6. Track pod friction (all four pods) ════════════════ -->
  <!--
    mu1/mu2 = 0.8 : rubber-track-on-concrete friction.
    kp      = stiff contact (hard surface).
    kd      = damping prevents bouncing at contact.
    minDepth: small allowed interpenetration stabilises low-speed contact.
  -->
  <xacro:macro name="track_friction" params="link_name">
    <gazebo reference="${link_name}">
      <mu1>0.8</mu1>  <!-- longitudinal: grip for forward/back -->
      <mu2>0.3</mu2>  <!-- lateral: LOW so tracks can skid-steer and TURN -->
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <minDepth>0.001</minDepth>
      <maxContacts>4</maxContacts>
    </gazebo>
  </xacro:macro>

  <xacro:track_friction link_name="front_left_track_link"/>
  <xacro:track_friction link_name="rear_left_track_link"/>
  <xacro:track_friction link_name="front_right_track_link"/>
  <xacro:track_friction link_name="rear_right_track_link"/>

  <!-- ══ 7. Gazebo material colours ═══════════════════════════ -->
  <gazebo reference="base_link">        <material>Gazebo/Silver</material>    </gazebo>
  <gazebo reference="front_left_track_link">  <material>Gazebo/DarkGrey</material> </gazebo>
  <gazebo reference="rear_left_track_link">   <material>Gazebo/DarkGrey</material> </gazebo>
  <gazebo reference="front_right_track_link"> <material>Gazebo/DarkGrey</material> </gazebo>
  <gazebo reference="rear_right_track_link">  <material>Gazebo/DarkGrey</material> </gazebo>
  <gazebo reference="raspberry_pi_link"> <material>Gazebo/Green</material>    </gazebo>
  <gazebo reference="arduino_link">      <material>Gazebo/Blue</material>     </gazebo>
  <gazebo reference="battery_link">      <material>Gazebo/Black</material>    </gazebo>
  <gazebo reference="esp32_link">        <material>Gazebo/Blue</material>     </gazebo>
  <gazebo reference="stm32_link">        <material>Gazebo/Red</material>      </gazebo>
  <gazebo reference="imu_link">          <material>Gazebo/Blue</material>     </gazebo>
  <gazebo reference="downward_camera_link"> <material>Gazebo/DarkGrey</material> </gazebo>
  <gazebo reference="front_tof_link">       <material>Gazebo/Blue</material>  </gazebo>
  <gazebo reference="front_left_tof_link">  <material>Gazebo/Blue</material>  </gazebo>
  <gazebo reference="front_right_tof_link"> <material>Gazebo/Blue</material>  </gazebo>
  <gazebo reference="rear_left_tof_link">   <material>Gazebo/Blue</material>  </gazebo>
  <gazebo reference="rear_right_tof_link">  <material>Gazebo/Blue</material>  </gazebo>

</robot>
