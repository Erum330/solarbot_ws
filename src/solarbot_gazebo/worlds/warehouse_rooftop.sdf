<?xml version="1.0"?>
<!--
  warehouse_rooftop.sdf  –  Gazebo Harmonic / SDF 1.9
  ──────────────────────────────────────────────────────────────────
  UAE warehouse rooftop with flat solar panels.

  Layout (bird's eye, +x = east):
    • Concrete roof membrane, 16 m × 12 m
    • 10 solar panels in 2 columns × 5 rows
      Column 1: x = 0.0   Column 2: x = 4.5
      Rows: y = [0.0, 2.1, 4.2, 6.3, 8.4]
    • Panels lie flat on roof surface (z = 0.02 m centre, 4 cm thick)
    • Dark gap strips between rows and columns
    • Docking station: x = -4.50, y = 4.20  (west of panels, open east)
    • Robot spawns at x = -3.20, y = 4.20 facing east (+x)
    • Textures: solar_panel_01_dust.png … solar_panel_10_dust.png
      (generate with: python3 scripts/make_texture.py)
  ──────────────────────────────────────────────────────────────────
-->
<sdf version="1.9">
<world name="warehouse_rooftop">

  <!-- ── Plugins ───────────────────────────────────────────── -->
  <plugin filename="gz-sim-physics-system"
          name="gz::sim::systems::Physics"/>
  <plugin filename="gz-sim-user-commands-system"
          name="gz::sim::systems::UserCommands"/>
  <plugin filename="gz-sim-scene-broadcaster-system"
          name="gz::sim::systems::SceneBroadcaster"/>
  <plugin filename="gz-sim-sensors-system"
          name="gz::sim::systems::Sensors">
    <render_engine>ogre2</render_engine>
  </plugin>
  <plugin filename="gz-sim-imu-system"
          name="gz::sim::systems::Imu"/>

  <!-- ── Physics ───────────────────────────────────────────── -->
  <gravity>0 0 -9.8</gravity>

  <!-- ── UAE sun (high elevation, strong) ─────────────────── -->
  <light name="sun" type="directional">
    <cast_shadows>true</cast_shadows>
    <pose>0 0 10 0 0 0</pose>
    <diffuse>0.95 0.93 0.85 1</diffuse>
    <specular>0.25 0.24 0.20 1</specular>
    <direction>-0.3 0.1 -0.95</direction>
    <intensity>1.1</intensity>
  </light>

  <!-- Sky fill (ambient scatter) -->
  <light name="sky_fill" type="directional">
    <direction>0 0 -1</direction>
    <diffuse>0.40 0.48 0.58 1</diffuse>
    <specular>0 0 0 1</specular>
    <intensity>0.35</intensity>
    <cast_shadows>false</cast_shadows>
  </light>

  <!-- ── Scene ─────────────────────────────────────────────── -->
  <scene>
    <ambient>0.55 0.55 0.50 1</ambient>
    <background>0.70 0.80 0.95 1</background>
    <shadows>true</shadows>
    <grid>false</grid>
  </scene>

  <!-- ── Ground plane (physics collision at z=0) ───────────── -->
  <model name="ground_plane">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>100 100</size>
          </plane>
        </geometry>
        <surface>
          <friction>
            <ode><mu>0.8</mu><mu2>0.8</mu2></ode>
          </friction>
        </surface>
      </collision>
    </link>
  </model>

  <!-- ── Warehouse roof surface (visual concrete membrane) ─── -->
  <model name="warehouse_roof">
    <static>true</static>
    <pose>2.2500 4.2000 -0.10 0 0 0</pose>
    <link name="link">
      <visual name="visual">
        <geometry>
          <box><size>16.0 12.0 0.20</size></box>
        </geometry>
        <material>
          <ambient>0.82 0.80 0.74 1</ambient>
          <diffuse>0.85 0.83 0.76 1</diffuse>
          <specular>0.04 0.04 0.04 1</specular>
        </material>
      </visual>
      <!-- No collision — ground_plane handles that -->
    </link>
  </model>

  <!-- ── Solar panel array ─────────────────────────────────── -->
  <!--
    All panels lie flat (no tilt, no posts).
    Panel: 4.0 m × 1.8 m × 0.04 m  (z-centre = 0.02 m)
    Top surface at z = 0.04 m — robot steps up 4 cm to drive on panel.
    Gap strips are dark (z ~ 0 m) — ToF cliff sensors detect these.
  -->

    <!-- ── panel_1 ── -->
    <model name="panel_1">
      <static>true</static>
      <pose>0.0000 0.0000 0.0200 0 0 0</pose>
      <link name="link">

        <!-- Aluminium frame (full panel footprint) -->
        <visual name="frame_visual">
          <geometry><box><size>4.0 1.8 0.04</size></box></geometry>
          <material>
            <ambient>0.62 0.62 0.60 1</ambient>
            <diffuse>0.65 0.65 0.63 1</diffuse>
            <specular>0.4 0.4 0.4 1</specular>
          </material>
        </visual>

        <!-- Cell surface with dust texture (2 mm proud of frame) -->
        <visual name="cell_visual">
          <pose>0 0 0.0220 0 0 0</pose>
          <geometry><box><size>3.90 1.70 0.003</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <specular>0.15 0.15 0.15 1</specular>
            <pbr>
              <metal>
                <albedo_map>../materials/textures/solar_panel_01_dust.png</albedo_map>
                <roughness>0.38</roughness>
                <metalness>0.08</metalness>
              </metal>
            </pbr>
          </material>
        </visual>

        <!-- Collision (full box) -->
        <collision name="collision">
          <geometry><box><size>4.0 1.8 0.04</size></box></geometry>
          <surface>
            <friction>
              <ode><mu>0.7</mu><mu2>0.7</mu2></ode>
            </friction>
          </surface>
        </collision>

      </link>
    </model>
    <model name="gap_1">
      <static>true</static>
      <pose>0.0000 1.0500 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>4.0 0.3 0.010</size></box></geometry>
          <material>
            <ambient>0.22 0.22 0.22 1</ambient>
            <diffuse>0.22 0.22 0.22 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry><box><size>4.0 0.3 0.010</size></box></geometry>
        </collision>
      </link>
    </model>
    <!-- ── panel_2 ── -->
