          <geometry><box><size>3.90 1.70 0.003</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <specular>0.15 0.15 0.15 1</specular>
            <pbr>
              <metal>
                <albedo_map>../materials/textures/solar_panel_10_dust.png</albedo_map>
                <roughness>0.38</roughness>
                <metalness>0.08</metalness>
              </metal>
            </pbr>
          </material>
        </visual>

        <!-- Collision (full box) -->
        <collision name="collision">
          <geometry><box><size>4.0 1.8 0.04</size></box></geometry>
          <surface>
            <friction>
              <ode><mu>0.7</mu><mu2>0.7</mu2></ode>
            </friction>
          </surface>
        </collision>

      </link>
    </model>
    <model name="col_gap">
      <static>true</static>
      <pose>2.2500 4.2000 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.500 10.200 0.010</size></box></geometry>
          <material>
            <ambient>0.22 0.22 0.22 1</ambient>
            <diffuse>0.22 0.22 0.22 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.500 10.200 0.010</size></box></geometry>
        </collision>
      </link>
    </model>

  <!-- ── Docking station ───────────────────────────────────── -->
  <!--
    Open toward +x (east, toward panels).
    Robot spawn point: x=-3.20  y=4.20  z=0.05  yaw=0
  -->

    <!-- ══════════════════════════════════════════════════════════ -->
    <!-- Docking station                                           -->
    <!-- Grey U-cradle on the roof, open toward panels (+x).      -->
    <!-- Robot spawns inside, facing east (yaw=0).                -->
    <!-- ══════════════════════════════════════════════════════════ -->
    <model name="docking_station">
      <static>true</static>
      <pose>-4.5000 4.2000 0 0 0 0</pose>
      <link name="dock_link">

        <!-- Floor platform (raised 2 cm, orange marker) -->
        <visual name="floor_visual">
          <pose>0 0 0.010 0 0 0</pose>
          <geometry><box><size>1.80 0.80 0.020</size></box></geometry>
          <material>
            <ambient>0.90 0.55 0.05 1</ambient>
            <diffuse>0.90 0.55 0.05 1</diffuse>
          </material>
        </visual>
        <collision name="floor_col">
          <pose>0 0 0.010 0 0 0</pose>
          <geometry><box><size>1.80 0.80 0.020</size></box></geometry>
        </collision>

        <!-- Rear wall (closed end, -x side) -->
        <visual name="rear_wall_visual">
          <pose>-0.86 0 0.08 0 0 0</pose>
          <geometry><box><size>0.08 0.80 0.14</size></box></geometry>
          <material>
            <ambient>0.75 0.75 0.75 1</ambient>
            <diffuse>0.75 0.75 0.75 1</diffuse>
          </material>
        </visual>
        <collision name="rear_wall_col">
          <pose>-0.86 0 0.08 0 0 0</pose>
          <geometry><box><size>0.08 0.80 0.14</size></box></geometry>
        </collision>

        <!-- Left guide wall -->
        <visual name="left_wall_visual">
          <pose>0 0.40 0.065 0 0 0</pose>
          <geometry><box><size>1.80 0.06 0.11</size></box></geometry>
          <material>
            <ambient>0.75 0.75 0.75 1</ambient>
            <diffuse>0.75 0.75 0.75 1</diffuse>
          </material>
        </visual>
        <collision name="left_wall_col">
          <pose>0 0.40 0.065 0 0 0</pose>
          <geometry><box><size>1.80 0.06 0.11</size></box></geometry>
        </collision>

        <!-- Right guide wall -->
        <visual name="right_wall_visual">
          <pose>0 -0.40 0.065 0 0 0</pose>
          <geometry><box><size>1.80 0.06 0.11</size></box></geometry>
          <material>
            <ambient>0.75 0.75 0.75 1</ambient>
            <diffuse>0.75 0.75 0.75 1</diffuse>
          </material>
        </visual>
        <collision name="right_wall_col">
          <pose>0 -0.40 0.065 0 0 0</pose>
          <geometry><box><size>1.80 0.06 0.11</size></box></geometry>
        </collision>

        <!-- Charging contact — left (yellow cylinder) -->
        <visual name="contact_left_visual">
          <pose>-0.72 0.15 0.045 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.015</radius><length>0.05</length></cylinder></geometry>
          <material>
            <ambient>0.95 0.90 0.05 1</ambient>
            <diffuse>0.95 0.90 0.05 1</diffuse>
            <specular>1 1 1 1</specular>
          </material>
        </visual>

        <!-- Charging contact — right (yellow cylinder) -->
        <visual name="contact_right_visual">
          <pose>-0.72 -0.15 0.045 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.015</radius><length>0.05</length></cylinder></geometry>
          <material>
            <ambient>0.95 0.90 0.05 1</ambient>
            <diffuse>0.95 0.90 0.05 1</diffuse>
            <specular>1 1 1 1</specular>
          </material>
        </visual>

        <!-- Status indicator pole -->
        <visual name="pole_visual">
          <pose>-0.72 0 0.20 0 0 0</pose>
          <geometry><cylinder><radius>0.010</radius><length>0.36</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>

        <!-- Status light (green = ready) -->
        <visual name="light_visual">
          <pose>-0.72 0 0.40 0 0 0</pose>
          <geometry><sphere><radius>0.018</radius></sphere></geometry>
          <material>
            <ambient>0.0 1.0 0.2 1</ambient>
            <diffuse>0.0 1.0 0.2 1</diffuse>
            <emissive>0.0 0.7 0.1 1</emissive>
          </material>
        </visual>

        <!-- "DOCK" label arrow painted on floor (orange box strip) -->
        <visual name="arrow_visual">
          <pose>0.60 0 0.021 0 0 0</pose>
          <geometry><box><size>0.40 0.08 0.002</size></box></geometry>
          <material>
            <ambient>1.0 1.0 1.0 1</ambient>
            <diffuse>1.0 1.0 1.0 1</diffuse>
          </material>
        </visual>

      </link>
    </model>

</world>
</sdf>
