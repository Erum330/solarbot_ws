<?xml version="1.0"?>
<!--
  warehouse_rooftop.sdf  -  Gazebo Harmonic / SDF 1.9
  ──────────────────────────────────────────────────────────────────
  Panel thickness: 0.01 m (1 cm step above roof)
  Gap height:      0.00 m (COMPLETELY ZERO HEIGHT / LEVEL WITH ROOF)

  Robot spawn: x=-3.20 y=4.20 z=0.05 yaw=0
  ──────────────────────────────────────────────────────────────────
-->
<sdf version="1.9">
<world name="warehouse_rooftop">

  <plugin filename="gz-sim-physics-system"        name="gz::sim::systems::Physics"/>
  <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
  <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
