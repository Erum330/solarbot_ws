<?xml version="1.0"?>
<!--
  warehouse_rooftop.sdf  -  Gazebo Harmonic / SDF 1.9
  ──────────────────────────────────────────────────────────────────
  Panel thickness:   0.15 m (15 cm elevated table drop above roof)
  Panel Top Surface: z = +0.15 m
  Warehouse Roof:    z = 0.00 m
  Gap height:        z = 0.0001 m (COMPLETELY LEVEL WITH ROOF / 15 cm DROP)

  Robot spawn: "-x", "-1.75", "-y", "3.45", "-z", "0.20"
  ──────────────────────────────────────────────────────────────────
-->
<sdf version="1.9">
<world name="warehouse_rooftop">

  <plugin filename="gz-sim-physics-system"        name="gz::sim::systems::Physics"/>
  <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
  <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
  <plugin filename="gz-sim-sensors-system"       name="gz::sim::systems::Sensors">
    <render_engine>ogre2</render_engine>
  </plugin>
  <plugin filename="gz-sim-imu-system"           name="gz::sim::systems::Imu"/>
  <plugin filename="gz-sim-navsat-system"        name="gz::sim::systems::NavSat"/>

  <spherical_coordinates>
    <surface_model>EARTH_WGS84</surface_model>
    <latitude_deg>24.4539</latitude_deg>
    <longitude_deg>54.3773</longitude_deg>
    <elevation>0</elevation>
    <heading_deg>0</heading_deg>
  </spherical_coordinates>

  <gravity>0 0 -9.8</gravity>

  <light name="sun" type="directional">
    <cast_shadows>true</cast_shadows>
    <pose>0 0 10 0 0 0</pose>
    <diffuse>0.95 0.93 0.85 1</diffuse>
    <specular>0.25 0.24 0.20 1</specular>
    <direction>-0.3 0.1 -0.95</direction>
    <intensity>1.1</intensity>
  </light>
  <light name="sky_fill" type="directional">
    <direction>0 0 -1</direction>
    <diffuse>0.40 0.48 0.58 1</diffuse>
    <specular>0 0 0 1</specular>
    <intensity>0.35</intensity>
    <cast_shadows>false</cast_shadows>
  </light>

  <scene>
    <ambient>0.55 0.55 0.50 1</ambient>
    <background>0.70 0.80 0.95 1</background>
    <shadows>true</shadows>
    <grid>false</grid>
  </scene>

  <model name="ground_plane">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry>
          <plane><normal>0 0 1</normal><size>100 100</size></plane>
        </geometry>
        <surface>
          <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
        </surface>
      </collision>
    </link>
  </model>

  <!-- Warehouse roof top surface at z = 0.00 -->
  <model name="warehouse_roof">
    <static>true</static>
    <pose>2.2500 4.2000 -0.10 0 0 0</pose>
    <link name="link">
      <visual name="visual">
        <geometry><box><size>16.0 14.0 0.20</size></box></geometry>
        <material>
          <ambient>0.82 0.80 0.74 1</ambient>
          <diffuse>0.85 0.83 0.76 1</diffuse>
          <specular>0.04 0.04 0.04 1</specular>
        </material>
      </visual>
      <collision name="collision">
        <geometry><box><size>16.0 14.0 0.20</size></box></geometry>
        <surface>
          <friction>
            <ode><mu>0.8</mu><mu2>0.8</mu2></ode>
          </friction>
        </surface>
      </collision>
    </link>
  </model>

  <!-- ============================================================ -->
  <!-- COLUMN 1 (X = 0.0000 m)                                      -->
  <!-- ============================================================ -->

  <!-- ── panel_1 ── -->
  <model name="panel_1">
    <static>true</static>
    <pose>0.0000 0.5400 0.0750 0 0 0</pose>
    <link name="link">
